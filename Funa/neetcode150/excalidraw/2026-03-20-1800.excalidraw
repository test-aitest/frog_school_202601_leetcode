      "boundElements": null,
      "updated": 1774019714463,
      "link": null,
      "locked": false,
      "text": "Pseudocode\n\ncount = frequency map\nfreq = array of n+1 empty lists\n\nfor loop count\n    freq[count[num]].append(num)\n\nresult = []\nfor loop n down to 1\n    for loop freq[i]\n        result.append(num)\n        if len(result) == k:\n            return result",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pseudocode\n\ncount = frequency map\nfreq = array of n+1 empty lists\n\nfor loop count\n    freq[count[num]].append(num)\n\nresult = []\nfor loop n down to 1\n    for loop freq[i]\n        result.append(num)\n        if len(result) == k:\n            return result",
      "autoResize": true,
      "lineHeight": 1.25
    },
