    {
      "id": "XxK1HhdKwFYl3HIuwfdxq",
      "type": "text",
      "x": 3426.4674444002003,
      "y": 11826.38748325104,
      "width": 1691.832663926344,
      "height": 1865.4117883107826,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bg2",
      "roundness": null,
      "seed": 1693608890,
      "version": 2471,
      "versionNonce": 1468542249,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772351338703,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def combinationSum2(self, candidates: List[int], target: int) -> List[List[int]]:\n        # sort\n        candidates.sort()\n\n        res = []\n        def dfs(i, cur, total):\n            # basecase\n            if total == target:\n                res.append(cur.copy())\n                return\n            if total > target or i >= len(candidates):\n                return\n\n            # Take\n            cur.append(candidates[i])\n            dfs(i+1, cur, total + candidates[i])\n\n            # Not to take\n            cur.pop()\n            # we want to skip the subsequent identical element\n            while candidates[i] == candidates[i+1] and i+1 < len(candidates):\n                i += 1\n            # when end the loop, for example [1, 1, 4, 5]\n            # i = 0, while condition is true so increment\n            # i = 1, it is false, so end the loop\n            # then we want to move on next index , element 4\n            dfs(i+1, cur, total)\n\n        dfs(0, [] ,0)\n        return res",
      "fontSize": 48.139659053181475,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def combinationSum2(self, candidates: List[int], target: int) -> List[List[int]]:\n        # sort\n        candidates.sort()\n\n        res = []\n        def dfs(i, cur, total):\n            # basecase\n            if total == target:\n                res.append(cur.copy())\n                return\n            if total > target or i >= len(candidates):\n                return\n\n            # Take\n            cur.append(candidates[i])\n            dfs(i+1, cur, total + candidates[i])\n\n            # Not to take\n            cur.pop()\n            # we want to skip the subsequent identical element\n            while candidates[i] == candidates[i+1] and i+1 < len(candidates):\n                i += 1\n            # when end the loop, for example [1, 1, 4, 5]\n            # i = 0, while condition is true so increment\n            # i = 1, it is false, so end the loop\n            # then we want to move on next index , element 4\n            dfs(i+1, cur, total)\n\n        dfs(0, [] ,0)\n        return res",
      "autoResize": true,
      "lineHeight": 1.25
    },
