    {
      "id": "2ofwECokh0Z4Mc42uNIIj",
      "type": "text",
      "x": 3976.1827584090092,
      "y": 5779.708647371981,
      "width": 831.1676635742188,
      "height": 1305,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEz",
      "roundness": null,
      "seed": 964619227,
      "version": 882,
      "versionNonce": 1188687645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771941259983,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def subsets(self, nums: List[int]) -> List[List[int]]:\n        res = []\n        \n        subset = []\n        def dfs(i):\n            # base case\n            # ending condition\n            if i >= len(nums):\n                res.append(subset.copy())\n                return\n            \n            # pick up\n            # add nums[i] to subset \n            # we call dfs and pass the next input value\n            subset.append(nums[i])\n            dfs(i + 1)\n\n            # Not pick up\n            # remove nums[i] from subset\n            # we call dfs and pass the next input value\n            subset.pop()\n            dfs(i+1)\n            \n          # we call dfs and pass the first index\n          dfs(0)\n          # return res \n          return res\n      ",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def subsets(self, nums: List[int]) -> List[List[int]]:\n        res = []\n        \n        subset = []\n        def dfs(i):\n            # base case\n            # ending condition\n            if i >= len(nums):\n                res.append(subset.copy())\n                return\n            \n            # pick up\n            # add nums[i] to subset \n            # we call dfs and pass the next input value\n            subset.append(nums[i])\n            dfs(i + 1)\n\n            # Not pick up\n            # remove nums[i] from subset\n            # we call dfs and pass the next input value\n            subset.pop()\n            dfs(i+1)\n            \n          # we call dfs and pass the first index\n          dfs(0)\n          # return res \n          return res\n      ",
      "autoResize": true,
      "lineHeight": 1.25
    },
