    {
      "id": "KOoPiZv5yzpl64-KLbxH1",
      "type": "text",
      "x": 5173.022771253962,
      "y": 9216.438705090743,
      "width": 1157.2554931640625,
      "height": 1080,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOU",
      "roundness": null,
      "seed": 1853115101,
      "version": 397,
      "versionNonce": 789759283,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771944315782,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def combinationSum(self, nums: List[int], target: int) -> List[List[int]]:\n        res = []\n\n        def dfs(i, cur, sum):\n            # basecase\n            # ending path\n            if sum == target:\n                res.append(cur.copy())\n                return \n            if i >= len(nums) or sum > target:\n                return\n\n            # Take\n            cur.append(nums[i])\n            dfs(i, cur, sum+nums[i])\n\n            # Not to take\n            cur.pop()\n            dfs(i + 1, cur, sum)\n\n        dfs(0, [], 0)\n\n        return res",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def combinationSum(self, nums: List[int], target: int) -> List[List[int]]:\n        res = []\n\n        def dfs(i, cur, sum):\n            # basecase\n            # ending path\n            if sum == target:\n                res.append(cur.copy())\n                return \n            if i >= len(nums) or sum > target:\n                return\n\n            # Take\n            cur.append(nums[i])\n            dfs(i, cur, sum+nums[i])\n\n            # Not to take\n            cur.pop()\n            dfs(i + 1, cur, sum)\n\n        dfs(0, [], 0)\n\n        return res",
      "autoResize": true,
      "lineHeight": 1.25
    },
