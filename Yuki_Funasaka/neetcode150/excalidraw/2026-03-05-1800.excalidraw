    {
      "id": "x3GtmqpsckaMdoVEL2dVR",
      "type": "text",
      "x": 15119.084777669123,
      "y": 12493.374496752454,
      "width": 984.383544921875,
      "height": 1350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c078",
      "roundness": null,
      "seed": 1638734211,
      "version": 1590,
      "versionNonce": 1522517275,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772675835611,
      "link": null,
      "locked": false,
      "text": "def permute(self, nums: List[int]) -> List[List[int]]:\n    res = []\n\n    # base case(guard clause)\n    # if length nums is 1, only permutaion is the list itself, [[1]]\n    if len(nums) == 1:\n        return [nums[:]]\n\n    # loop through length of nums\n    for i in range(len(nums)):\n        # 1st\n        # popping front element\n        n = nums.pop(0)\n        # recursion(we call self.permute)\n        pems = self.permute(nums)\n\n        # loop through perm(return of self.permute)\n        for p in pems:\n            # 2nd\n            # attach\n            p.append(n)\n\n        # collect (add to res)\n        res.extend(pems)\n        # 3rd\n        # backtrack(back popping nums to remaining list)\n        nums.append(n)\n     return result\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def permute(self, nums: List[int]) -> List[List[int]]:\n    res = []\n\n    # base case(guard clause)\n    # if length nums is 1, only permutaion is the list itself, [[1]]\n    if len(nums) == 1:\n        return [nums[:]]\n\n    # loop through length of nums\n    for i in range(len(nums)):\n        # 1st\n        # popping front element\n        n = nums.pop(0)\n        # recursion(we call self.permute)\n        pems = self.permute(nums)\n\n        # loop through perm(return of self.permute)\n        for p in pems:\n            # 2nd\n            # attach\n            p.append(n)\n\n        # collect (add to res)\n        res.extend(pems)\n        # 3rd\n        # backtrack(back popping nums to remaining list)\n        nums.append(n)\n     return result\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
