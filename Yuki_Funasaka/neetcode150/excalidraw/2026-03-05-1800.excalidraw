    {
      "id": "JEPLc5fbRcqNtRko6Sy1E",
      "type": "text",
      "x": 4819.872694451018,
      "y": 16649.64009509476,
      "width": 429.0029861895152,
      "height": 415.86187211320566,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "boq",
      "roundness": null,
      "seed": 628871727,
      "version": 665,
      "versionNonce": 1720984809,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772351371072,
      "link": null,
      "locked": false,
      "text": "haystack = \"bacd\"\nneedle = \"ac\"\n\nfunction findNeedle(haystack, needle):\n    # len(n) == 2, len(h) == 4\n    if len(needle) == 0 or len(needle) > len(haystack):\n        return -1\n\n    # 0 ~ i ~ 2\n    for i in range(len(haystack) - len(needle)):\n        if haystack[i:i+len(needle)] == needle:\n            return i\n\n        # i = 0 false\n        # i = 1 true.    return 1\n        \n\n    return -1",
      "fontSize": 18.482749871698033,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "haystack = \"bacd\"\nneedle = \"ac\"\n\nfunction findNeedle(haystack, needle):\n    # len(n) == 2, len(h) == 4\n    if len(needle) == 0 or len(needle) > len(haystack):\n        return -1\n\n    # 0 ~ i ~ 2\n    for i in range(len(haystack) - len(needle)):\n        if haystack[i:i+len(needle)] == needle:\n            return i\n\n        # i = 0 false\n        # i = 1 true.    return 1\n        \n\n    return -1",
      "autoResize": true,
      "lineHeight": 1.25
    },
