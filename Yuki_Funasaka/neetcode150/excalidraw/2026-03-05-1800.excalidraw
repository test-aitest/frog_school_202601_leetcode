      "updated": 1773197369311,
      "link": null,
      "locked": false,
      "text": "create stack to store opening brackets\nwe iterate every characters of s\n    If it is an opneing bracket, push it onto the stack\n    If it is a closing bracket,\n        check if the stack is not empty and its top\n        matches the correponding opening bracket\n            If yes, pop the stack\n            otherwaise return false\n\nAfter ending loop\n    If the stack is empty, return True\n    otherwise return false\n    ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "create stack to store opening brackets\nwe iterate every characters of s\n    If it is an opneing bracket, push it onto the stack\n    If it is a closing bracket,\n        check if the stack is not empty and its top\n        matches the correponding opening bracket\n            If yes, pop the stack\n            otherwaise return false\n\nAfter ending loop\n    If the stack is empty, return True\n    otherwise return false\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
