      "seed": 294541542,
      "version": 797,
      "versionNonce": 954822566,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773197818524,
      "link": null,
      "locked": false,
      "text": "# create stack to store opening brackets\nstack = []\n\npair = {')': '(', ']': '[', '}': '{'}\n# we iterate every characters of s\nfor c in s:\n    # If it is an opneing bracket, push it onto the stack\n    if c == \"(\" or c ==\"{\" or c == \"[\":\n        stack.append(c)\n        continue\n    # If it is a closing bracket,\n    else:\n        # check if the stack is not empty and its top\n        # matches the correponding opening bracket\n        if stack and stack[-1] == pair[c]:\n            # If yes, pop the stack\n            stack.pop()\n        # otherwaise return false\n        else:\n            return False\n\n# After ending loop\n    # If the stack is empty, return True\n    # otherwise return false\nreturn stack == []\n    ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# create stack to store opening brackets\nstack = []\n\npair = {')': '(', ']': '[', '}': '{'}\n# we iterate every characters of s\nfor c in s:\n    # If it is an opneing bracket, push it onto the stack\n    if c == \"(\" or c ==\"{\" or c == \"[\":\n        stack.append(c)\n        continue\n    # If it is a closing bracket,\n    else:\n        # check if the stack is not empty and its top\n        # matches the correponding opening bracket\n        if stack and stack[-1] == pair[c]:\n            # If yes, pop the stack\n            stack.pop()\n        # otherwaise return false\n        else:\n            return False\n\n# After ending loop\n    # If the stack is empty, return True\n    # otherwise return false\nreturn stack == []\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    }
