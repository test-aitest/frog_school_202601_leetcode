    {
      "id": "m9UHeSxL7QzvPLKabOZUG",
      "type": "text",
      "x": 13753.403043754475,
      "y": 12509.875400663359,
      "width": 1153.1876220703125,
      "height": 810,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c08D",
      "roundness": null,
      "seed": 813004539,
      "version": 2403,
      "versionNonce": 1266269719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772677793941,
      "link": null,
      "locked": false,
      "text": "def permute(self, nums: List[int]) -> List[List[int]]:\n    # res List[List[int]]\n\n    # base case(guard clause)\n    # if length of nums equal 1, the only permutaion is the list itself, [[1]]\n\n    # loop through length of nums\n        # 1. pop the front\n        # recursion(remaining nums) \n        \n        # 2. attach and collect\n        # loop through remaining permutations\n            # add pop num to the end of each permutaions\n        \n        # add the each permutaions to the res\n        # 3. backtrack add back the pop num to the remaining nums\n\n    # return res",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def permute(self, nums: List[int]) -> List[List[int]]:\n    # res List[List[int]]\n\n    # base case(guard clause)\n    # if length of nums equal 1, the only permutaion is the list itself, [[1]]\n\n    # loop through length of nums\n        # 1. pop the front\n        # recursion(remaining nums) \n        \n        # 2. attach and collect\n        # loop through remaining permutations\n            # add pop num to the end of each permutaions\n        \n        # add the each permutaions to the res\n        # 3. backtrack add back the pop num to the remaining nums\n\n    # return res",
      "autoResize": true,
      "lineHeight": 1.25
    },
