      "seed": 1342136208,
      "version": 602,
      "versionNonce": 1203113840,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773418873516,
      "link": null,
      "locked": false,
      "text": "def groupAnagrams(self, strs: List[str]) -> List[List[stg]]:\n    ans = defaultdict(list)\n\n    for s in strs:\n        count = [0] * 26\n        for c in s:\n            count[ord(c) - ord('a')] += 1\n        ans[tuple(count)].append(s)\n\n    return list(ans.values())",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def groupAnagrams(self, strs: List[str]) -> List[List[stg]]:\n    ans = defaultdict(list)\n\n    for s in strs:\n        count = [0] * 26\n        for c in s:\n            count[ord(c) - ord('a')] += 1\n        ans[tuple(count)].append(s)\n\n    return list(ans.values())",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
